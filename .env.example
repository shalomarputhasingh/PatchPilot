# --- Groq (server-side only) ---
GROQ_API_KEY=
# A Groq-hosted model that supports JSON output, e.g. openai/gpt-oss-120b. Required: no default is assumed.
GROQ_MODEL=
# Optional: override the Groq API base URL (proxies / test doubles).
GROQ_BASE_URL=

# --- Sandbox (server-side only) ---
# Adapter to use. "piston" = Piston-compatible execute API (POST {SANDBOX_API_URL}/api/v2/execute).
SANDBOX_PROVIDER=piston
SANDBOX_API_URL=
# Optional bearer token, sent as "Authorization: Bearer <key>" if set.
SANDBOX_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional limits
SESSION_BUDGET_MS=150000
SANDBOX_RUN_TIMEOUT_MS=10000
