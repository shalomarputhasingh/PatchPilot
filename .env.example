# --- Groq (server-side only) ---
GROQ_API_KEY=
# A Groq-hosted model that supports JSON output, e.g. openai/gpt-oss-120b. Required: no default is assumed.
GROQ_MODEL=
# Optional: override the Groq API base URL (proxies / test doubles).
GROQ_BASE_URL=

# --- Sandbox (server-side only) ---
# Adapter: "rapidapi" = SandboxAPI on RapidAPI (https://rapidapi.com/sandboxapidev/api/sandboxapi), the default when SANDBOX_API_URL is empty.
# "piston" = Piston-compatible execute API (POST {SANDBOX_API_URL}/api/v2/execute).
SANDBOX_PROVIDER=rapidapi
# rapidapi: leave empty (defaults to https://sandboxapi.p.rapidapi.com). piston: required.
SANDBOX_API_URL=
# rapidapi: your X-RapidAPI-Key. piston: optional bearer token.
SANDBOX_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional limits
SESSION_BUDGET_MS=150000
SANDBOX_RUN_TIMEOUT_MS=10000
